{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "cwd": "desktop/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "site-dev",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/riftroute-server",
        "serve",
        "-listen",
        "127.0.0.1:7781",
        "-data",
        "dist/site-dev"
      ],
      "port": 7781
    }
  ]
}
